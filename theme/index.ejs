<%- include('_includes/header'); -%>

<header class="intro mar-tb-7">
    <h1 class="intro__head"><%- siteConfig.title %>
        <div class="intro__sub"><%- siteConfig.subtitle %></div>
    </h1>
</header>

<%
let counter = 0;
// Build-time verdict only. Time moves forward, so the client script below can
// promote a draft to published but never the reverse -- which makes this the
// safe fallback state when JavaScript is unavailable.
const isPublished = isoDate => new Date(`${isoDate}T00:00:00`) <= new Date();
const years = Array.from(groupedPosts.keys()).sort((a, b) => b - a) || [];
const mid = parseInt((years.length / 2) || 1, 10) - 1;
        for (let year of years) {
%>
    <section id="y <%- year %>" class="mar-b-7">
        <h3 class="section__title"><%- year %></h3>
        <div class="post-list">
            <% for (let post of groupedPosts.get(year)) { %>
              <%
                const postHref = `${siteConfig.baseUrl || ''}${post.externalUrl || post.permalink}`;
                const postTarget = post.externalUrl ? '_blank' : '_self';
                const published = isPublished(post.isoDate);
                // A draft carries no href, which is what makes the anchor inert
                // and unfocusable until the script below promotes it.
                const linkAttrs = published ? ` href="${postHref}" target="${postTarget}"` : '';
              %>
                <a class="post<%- published ? '' : ' draft' %>"<%- linkAttrs %>
                   data-publish="<%- post.isoDate %>"
                   data-href="<%- postHref %>"
                   data-target="<%- postTarget %>">
                    <span class="post__title"><%- post.title %></span>
                    <time class="post__date" datetime="<%- post.isoDate %>"><%- post.date %></time>
                </a>
            <% } %>
        </div>
    </section>
    <% if (counter === mid) { %>
        <%- include('_includes/newsletter', { siteConfig }) %>
    <% } %>
<%
    counter++;
}
%>

<!-- If counter never reached 1 -->
<% if (counter === 0) { %>
    <%- include('_includes/newsletter', { siteConfig }) %>
<% } %>

<script>
  // A post whose date has arrived since the last build is still marked as a
  // draft in this HTML. Promote it now, using the visitor's clock rather than
  // the build clock. Dates are parsed without a zone, so a post goes live at
  // midnight local to whoever is reading.
  (function () {
    var now = new Date();
    var drafts = document.querySelectorAll('a.post.draft[data-publish]');

    Array.prototype.forEach.call(drafts, function (el) {
      if (new Date(el.getAttribute('data-publish') + 'T00:00:00') > now) {
        return;
      }

      el.setAttribute('href', el.getAttribute('data-href'));
      el.setAttribute('target', el.getAttribute('data-target'));
      el.classList.remove('draft');
    });
  })();
</script>

<%- include('_includes/footer', { siteConfig }) %>
